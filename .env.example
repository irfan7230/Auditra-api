# ================================
# Auditra Server — Environment
# ================================

# Application
NODE_ENV=production
PORT=5000

# MongoDB (Atlas)
# Use your Atlas connection string (with URL-encoded special chars in password)
MONGO_URI=mongodb://<username>:<url-encoded-password>@<shard-host-1>:27017,<shard-host-2>:27017,<shard-host-3>:27017/<dbname>?ssl=true&authSource=admin&retryWrites=true&w=majority&appName=Auditra

# CORS — your Vercel frontend URL (no trailing slash)
# Add both preview and production URLs, comma-separated
ALLOWED_ORIGINS=https://auditra.vercel.app,https://your-preview-url.vercel.app

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_UPLOAD_MAX=5
RATE_LIMIT_QUERY_MAX=200

# Bulk Upload config
BULK_BATCH_SIZE=1000
BULK_MAX_RECORDS=50000
